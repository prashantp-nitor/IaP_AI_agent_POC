            # ---------------------------------------------------------------
            # Azure Cache for Redis — generated by IAAP Terraform Generator
            # ---------------------------------------------------------------

            terraform {
              required_version = ">= 1.5.0"

              required_providers {
                azurerm = {
                  source  = "hashicorp/azurerm"
                  version = "~> 3.0"
                }
              }

              backend "s3" {}
            }

            provider "azurerm" {
              features {}
            }

            # --- Decode the recommendation SKU token (e.g. "C1", "P2") ---
            locals {
              redis_family   = upper(substr(var.sku_name, 0, 1))
              redis_capacity = tonumber(substr(var.sku_name, 1, length(var.sku_name) - 1))
              redis_tier     = local.redis_family == "P" ? "Premium" : "Standard"
            }

            # --- Resource Group ---

            data "azurerm_resource_group" "rg" {
  name = var.resource_group_name
}

            # --- Redis Cache ---

            resource "azurerm_redis_cache" "redis" {
              name                = var.redis_name
              location            = data.azurerm_resource_group.rg.location
              resource_group_name = data.azurerm_resource_group.rg.name
              capacity            = local.redis_capacity
              family              = local.redis_family
              sku_name            = local.redis_tier
              minimum_tls_version = "1.2"

              tags = {
                managed_by = "iaap"
              }
            }
