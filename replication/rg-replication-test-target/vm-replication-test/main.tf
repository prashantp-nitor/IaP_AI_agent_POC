# ---------------------------------------------------------------
            # Azure Virtual Machine — generated by IAAP Terraform Generator
            # ---------------------------------------------------------------

            terraform {
              required_version = ">= 1.5.0"

              required_providers {
                azurerm = {
                  source  = "hashicorp/azurerm"
                  version = "~> 3.0"
                }
              }

            }

            # --- Resource Group ---

            data "azurerm_resource_group" "rg" {
  name = var.resource_group_name
}

                                # --- Networking (replication — real names from source RG) ---

                    resource "azurerm_virtual_network" "vnet" {
                      name                = "sampletestaks-vnet"
                      location            = data.azurerm_resource_group.rg.location
                      resource_group_name = data.azurerm_resource_group.rg.name
                      address_space       = ["10.0.0.0/16"]
                    }

                    resource "azurerm_subnet" "subnet" {
                      name                 = "sampletestaks-subnet"
                      resource_group_name  = data.azurerm_resource_group.rg.name
                      virtual_network_name = azurerm_virtual_network.vnet.name
                      address_prefixes     = ["10.0.1.0/24"]
                    }

                    resource "azurerm_public_ip" "pip" {
  name                = "vm-replication-testPublicIP"
  location            = data.azurerm_resource_group.rg.location
  resource_group_name = data.azurerm_resource_group.rg.name
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "nic" {
                      name                = "vm-replication-testVMNic"
                      location            = data.azurerm_resource_group.rg.location
                      resource_group_name = data.azurerm_resource_group.rg.name

                      ip_configuration {
                        name                          = "internal"
    public_ip_address_id          = azurerm_public_ip.pip.id
                        subnet_id                     = azurerm_subnet.subnet.id
                        private_ip_address_allocation = "Dynamic"
                      }
                    }

# --- Virtual Machine ---

            resource "azurerm_linux_virtual_machine" "vm" {
              name                = var.vm_name
              location            = data.azurerm_resource_group.rg.location
              resource_group_name = data.azurerm_resource_group.rg.name
              size                = var.vm_size

              network_interface_ids = [azurerm_network_interface.nic.id]

              os_disk {
                caching              = "ReadWrite"
                storage_account_type = "Premium_LRS"
              }

              source_image_reference {
                publisher = var.os_image_publisher
                offer     = var.os_image_offer
                sku       = var.os_image_sku
                version   = "latest"
              }

            admin_username                  = var.admin_username
admin_password                  = var.admin_password
disable_password_authentication = false

            }
