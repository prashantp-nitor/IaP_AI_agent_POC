# ---------------------------------------------------------------
# Zilliz Milvus Cluster — generated by IAAP Terraform Generator
# ---------------------------------------------------------------

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 3.0"
    }
    zilliz = {
      source  = "zilliztech/zilliz"
      version = "~> 1.0"
    }
  }

}

provider "zilliz" {
  api_key = var.zilliz_api_key
}

# --- Zilliz Cluster ---

# Zilliz maps its own regions, we usually supply 'azure-location'.
resource "zilliz_cluster" "cluster" {
  project_id   = var.zilliz_project_id
  name         = var.cluster_name
  cloud_region = "southindia"
  cu_size      = var.cu_size
  cluster_type = var.cluster_type
}
