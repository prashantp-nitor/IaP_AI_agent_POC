# ---------------------------------------------------------------
            # Azure Virtual Machine — generated by IAAP Terraform Generator
            # ---------------------------------------------------------------

            terraform {
              required_version = ">= 1.5.0"

              required_providers {
                azurerm = {
                  source  = "hashicorp/azurerm"
                  version = "~> 3.0"
                }
              }

            }

            # --- Resource Group ---

            data "azurerm_resource_group" "rg" {
  name = var.resource_group_name
}

                                # --- Networking (replication — real names from source RG) ---

                    resource "azurerm_virtual_network" "vnet" {
                      name                = "vm-test-sourceVNET"
                      location            = data.azurerm_resource_group.rg.location
                      resource_group_name = data.azurerm_resource_group.rg.name
                      address_space       = ["10.0.0.0/16"]
                    }

                    resource "azurerm_subnet" "subnet" {
                      name                 = "vm-test-sourceSubnet"
                      resource_group_name  = data.azurerm_resource_group.rg.name
                      virtual_network_name = azurerm_virtual_network.vnet.name
                      address_prefixes     = ["10.0.0.0/24"]
                    }

                    resource "azurerm_public_ip" "pip" {
  name                = "vm-test-sourcePublicIP"
  location            = data.azurerm_resource_group.rg.location
  resource_group_name = data.azurerm_resource_group.rg.name
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "nic" {
                      name                = "vm-test-sourceVMNic"
                      location            = data.azurerm_resource_group.rg.location
                      resource_group_name = data.azurerm_resource_group.rg.name

                      ip_configuration {
                        name                          = "internal"
    public_ip_address_id          = azurerm_public_ip.pip.id
                        subnet_id                     = azurerm_subnet.subnet.id
                        private_ip_address_allocation = "Dynamic"
                      }
                    }

# --- VM State Replication ---

resource "azurerm_snapshot" "vm_os_snapshot" {
  name                = "vm-test-source-os-snapshot"
  location            = data.azurerm_resource_group.rg.location
  resource_group_name = data.azurerm_resource_group.rg.name
  create_option       = "Copy"
  source_uri          = "/subscriptions/37edf351-2797-441e-8f2a-b27c5a9ed9e2/resourceGroups/rg-test-source/providers/Microsoft.Compute/disks/vm-test-source_OsDisk_1_a67dcad5ae40467e92ffbd0c3d309cff"
}

resource "azurerm_managed_disk" "vm_os_disk" {
  name                 = "vm-test-source-os-disk"
  location             = data.azurerm_resource_group.rg.location
  resource_group_name  = data.azurerm_resource_group.rg.name
  storage_account_type = "Standard_LRS"
  create_option        = "Copy"
  source_resource_id   = azurerm_snapshot.vm_os_snapshot.id
  os_type              = "Linux"
}
# --- Virtual Machine ---

resource "azurerm_virtual_machine" "vm" {
  name                = var.vm_name
  location            = data.azurerm_resource_group.rg.location
  resource_group_name = data.azurerm_resource_group.rg.name
  vm_size             = var.vm_size
  network_interface_ids = [azurerm_network_interface.nic.id]

  storage_os_disk {
    name              = "vm-test-source-os-disk-attached"
    caching           = "ReadWrite"
    create_option     = "Attach"
    managed_disk_id   = azurerm_managed_disk.vm_os_disk.id
    os_type           = "Linux"
  }

}
